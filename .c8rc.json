{
  "all": true,
  "extension": [".ts"],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules/**",
    "out/**",
    "dist/**",
    "coverage/**",
    ".vscode-test/**",
    "**/*.d.ts",
    "src/**/*.test.ts"
  ],
  "reporter": [
    "text",
    "html",
    "lcov"
  ],
  "reports-dir": "coverage",
  "sourceMap": true,
  "clean": true
}
